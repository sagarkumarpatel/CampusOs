# Backend Environment Variables — Template
# Copy this file to .env and fill in your values.
# DO NOT commit the actual .env file.

PORT=5000

# PostgreSQL connection string
# Local (Docker):  postgresql://postgres:postgres@localhost:5432/campusos?schema=public
# Railway/Supabase: paste the connection URL from their dashboard
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/campusos?schema=public"

# JWT Secrets — use long, random strings (e.g. `openssl rand -hex 64`)
JWT_SECRET="replace-with-a-strong-random-secret"
JWT_REFRESH_SECRET="replace-with-another-strong-random-secret"

# Token expiry durations
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Frontend origin (for CORS)
CORS_ORIGIN="http://localhost:3000"

NODE_ENV="development"

# Cloudinary Integration (Phase 4 — Events Hub Banner Storage)
# Obtain these credentials from your Cloudinary console/dashboard (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

